# Copy to .env (gitignored) and fill in values. Keep only placeholders/examples
# in this file — never real secrets.

# --- Jira (Cloud) — read lazily inside the Jira fetch step only ---
# e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net
# The Atlassian account email the API token belongs to (non-secret identifier)
JIRA_EMAIL=you@example.com
# SECRET — create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=replace-with-your-jira-api-token
# Optional delegated Jira OAuth (Milestone M3 foundation)
# JIRA_OAUTH_ENABLED=false
# JIRA_OAUTH_CLIENT_ID=your-atlassian-oauth-client-id
# JIRA_OAUTH_CALLBACK_URL=http://localhost:3000/auth/jira/callback
# JIRA_OAUTH_CLIENT_SECRET=replace-with-your-atlassian-oauth-client-secret
# JIRA_OAUTH_ENCRYPTION_KEY=replace-with-your-fernet-key
# JIRA_OAUTH_SCOPES=["read:jira-work","offline_access"]
# JIRA_OAUTH_STATE_TTL_MINUTES=10
# Optional repository hosting provider connection foundations (Milestone M4 foundation)
# GITHUB_OAUTH_ENABLED=false
# GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
# GITHUB_OAUTH_SCOPES=["repo","read:user"]
# GITLAB_OAUTH_ENABLED=false
# GITLAB_OAUTH_CLIENT_ID=your-gitlab-oauth-client-id
# GITLAB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/gitlab/callback
# GITLAB_OAUTH_SCOPES=["api","read_user"]

# --- Anthropic — consumed only by the planning agent step ---
# SECRET — https://platform.claude.com/
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# --- Optional overrides (defaults in app/core/config.py) ---
# ALLOWED_GIT_HOSTS=["github.com"]
# ALLOW_LOCAL_REPOS=false
# ALLOWED_LOCAL_REPO_ROOTS=["D:\\repos","D:\\workspaces"]
# ALLOW_DIRTY_LOCAL_REPOS=false
# REQUIRE_LOCAL_BRANCH_TICKET_MATCH=false
# AUTH_ENABLED=false
# AUTH_ALLOW_DEV_LOGIN=true
# AUTH_SESSION_COOKIE_NAME=jira2pullreq_session
# AUTH_SESSION_TTL_HOURS=12
# AUTH_SESSION_COOKIE_SECURE=false
# AUTH_TRUSTED_PROXY_ENABLED=false
# AUTH_TRUSTED_PROXY_SOURCES=["127.0.0.1/32","::1/128"]
# AUTH_TRUSTED_EMAIL_HEADER=X-Auth-Request-Email
# AUTH_TRUSTED_NAME_HEADER=X-Auth-Request-Name
# AUTH_TRUSTED_SUBJECT_HEADER=X-Auth-Request-User
# AUTH_TRUSTED_PROVIDER_NAME=trusted-proxy
# AUTH_ADMIN_EMAILS=["admin@example.com"]
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
#
# --- Planning/implementation agent (models, effort, budgets) ---
# Per-phase models: planning runs on a cheaper tier than implementation to save
# tokens (planning is analysis, not code-writing). Raise the plan model for
# hardest tickets.
# AGENT_PLAN_MODEL=claude-sonnet-5
# AGENT_IMPLEMENT_MODEL=claude-opus-4-8
# Reasoning depth: low|medium|high|xhigh|max. "medium" balances cost/quality.
# AGENT_EFFORT=medium
# Per-phase turn + USD caps (hard budget ceilings per run).
# AGENT_PLAN_MAX_TURNS=20
# AGENT_IMPLEMENT_MAX_TURNS=40
# AGENT_PLAN_MAX_BUDGET_USD=1.0
# AGENT_IMPLEMENT_MAX_BUDGET_USD=3.0
# AGENT_TIMEOUT_SECONDS=600
#
# --- Token-saving controls ---
# Stub mode returns a canned plan with NO API call — test the whole pipeline
# (Jira fetch, clone, repo map, UI, errors) with zero Anthropic credits.
# AGENT_PLAN_STUB=false
# Memoize plans: identical ticket+repo inputs reuse a stored plan (zero tokens).
# AGENT_PLAN_CACHE_ENABLED=true
# Max chars of the repo's CLAUDE.md/AGENTS.md/README injected into the prompt so
# the agent needs fewer exploration reads.
# AGENT_REPO_DOC_MAX_CHARS=8000
# Auto repo digest: a deterministic, ZERO-token orientation (languages, layout,
# key files, core modules, README excerpt) injected into planning; cached per
# repo state so it's built once per commit and reused across every ticket.
# AGENT_REPO_DIGEST_ENABLED=true
# AGENT_REPO_DIGEST_CACHE_ENABLED=true
# AGENT_REPO_DIGEST_MAX_CHARS=3000
