# Example shared-deployment reverse proxy for jira2pullreq.
#
# This config assumes:
# - oauth2-proxy listens on 127.0.0.1:4180
# - frontend listens on 127.0.0.1:3000
# - backend listens on 127.0.0.1:8000
# - nginx is the only caller allowed to reach the backend directly
#
# It keeps the app on a single origin and injects the exact trusted identity
# headers expected by the FastAPI backend.

upstream jira2pullreq_frontend {
    server 127.0.0.1:3000;
}

upstream jira2pullreq_backend {
    server 127.0.0.1:8000;
}

upstream jira2pullreq_oauth2_proxy {
    server 127.0.0.1:4180;
}

server {
    listen 443 ssl http2;
    server_name app.example.com;

    # Configure TLS for your environment.
    ssl_certificate     /etc/ssl/certs/app.example.com.crt;
    ssl_certificate_key /etc/ssl/private/app.example.com.key;

    # oauth2-proxy endpoints
    location /oauth2/ {
        proxy_pass http://jira2pullreq_oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
    }

    location = /oauth2/auth {
        internal;
        proxy_pass http://jira2pullreq_oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Original-URL $scheme://$host$request_uri;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # Backend API on the same origin
    location /api/ {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/sign_in;

        auth_request_set $auth_user  $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        auth_request_set $auth_name  $upstream_http_x_auth_request_preferred_username;

        proxy_pass http://jira2pullreq_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Override any client-supplied values with proxy-derived identity.
        proxy_set_header X-Auth-Request-User  $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;
        proxy_set_header X-Auth-Request-Name  $auth_name;
    }

    # Optional direct health probe for the backend
    location = /health {
        proxy_pass http://jira2pullreq_backend/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend app on the same origin
    location / {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/sign_in;

        proxy_pass http://jira2pullreq_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
