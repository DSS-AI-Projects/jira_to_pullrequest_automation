# Example nginx config for the docker-compose shared-auth topology.
#
# This variant uses docker service names on the internal network instead of
# host-loopback listeners.

upstream jira2pullreq_frontend {
    server frontend:3000;
}

upstream jira2pullreq_backend {
    server backend:8000;
}

upstream jira2pullreq_oauth2_proxy {
    server oauth2-proxy:4180;
}

server {
    listen 443 ssl http2;
    server_name ${APP_HOSTNAME};

    ssl_certificate     /etc/ssl/certs/${APP_HOSTNAME}.crt;
    ssl_certificate_key /etc/ssl/private/${APP_HOSTNAME}.key;

    location /oauth2/ {
        proxy_pass http://jira2pullreq_oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
    }

    location = /oauth2/auth {
        internal;
        proxy_pass http://jira2pullreq_oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Original-URL $scheme://$host$request_uri;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location /api/ {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/sign_in;

        auth_request_set $auth_user  $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        auth_request_set $auth_name  $upstream_http_x_auth_request_preferred_username;

        proxy_pass http://jira2pullreq_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Auth-Request-User  $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;
        proxy_set_header X-Auth-Request-Name  $auth_name;
    }

    location = /health {
        proxy_pass http://jira2pullreq_backend/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/sign_in;

        proxy_pass http://jira2pullreq_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
