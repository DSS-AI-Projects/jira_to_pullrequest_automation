# Settings for deploy/vm/docker-compose.yml. Non-secret only — copy to
# deploy/vm/vm.env.local (git-ignored) and adjust:
#   cp deploy/vm/vm.env.example deploy/vm/vm.env.local
#
# Secrets do NOT go here: the Entra client secret and cookie secret live in
# OAUTH2_PROXY_ENV_FILE, provider OAuth secrets and keys in BACKEND_ENV_FILE.

# DNS name users open; must match the TLS certificate and the Entra app's two
# Web redirect URIs: https://<APP_HOSTNAME>/oauth2/callback (sign-in) and
# https://<APP_HOSTNAME>/signin/signed-out (where sign-out returns).
APP_HOSTNAME=jira2pullreq.example.com
PUBLIC_HTTPS_PORT=443

# Entra ID tenant (Directory) ID — not a secret; it is also in the issuer URL.
# Sign out sends the browser to this tenant's logout page, ending the
# Microsoft session too.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Folder holding the certificate and key, and their file names inside it.
TLS_DIR=../../certs
TLS_CERT_FILE=STAR_example_com.crt
TLS_KEY_FILE=STAR_example_com.key

# Paths relative to deploy/vm/.
BACKEND_ENV_FILE=../../backend/.env
OAUTH2_PROXY_ENV_FILE=../oauth2-proxy/azure-entra.env.local

# Internal Docker network: <prefix>.0/24, nginx at <prefix>.10. Change it if
# the VM already routes this range (check: ip route; docker network ls).
APP_SUBNET_PREFIX=172.30.0

# Compose project name and the data volume holding the SQLite database.
# Moving from the repo-root stack? Set BACKEND_VAR_VOLUME to its existing
# volume (docker volume ls → e.g. <folder>_backend_var) to keep all jobs,
# users and provider connections.
COMPOSE_PROJECT_NAME=jira2pullreq
BACKEND_VAR_VOLUME=jira2pullreq_backend_var

# Database backups: the `backup` service snapshots the database every
# BACKUP_INTERVAL_HOURS into BACKUP_HOST_DIR on the VM and keeps the newest
# BACKUP_KEEP (deploy/vm/README.md, "5. Backups"). Create the folder first,
# owned by uid 1000 (the backend image's appuser):
#   sudo install -d -o 1000 -g 1000 -m 700 /var/backups/jira2pullreq
# One folder per instance on a shared VM. Copy snapshots off the VM; never
# store backend/.env's Fernet keys with them.
BACKUP_HOST_DIR=/var/backups/jira2pullreq
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Optional: host folder mounted read-only at /repos in the backend, for local
# repositories. Used only with docker-compose.local-repos.yml (README, "Local
# repositories"). E.g. D:/repos under Docker Desktop.
# LOCAL_REPOS_HOST_DIR=/srv/repos

# Container log rotation (json-file driver), per container: up to
# DOCKER_LOG_MAX_FILE files of DOCKER_LOG_MAX_SIZE each.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
