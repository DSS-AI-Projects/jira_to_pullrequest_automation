# oauth2-proxy environment example for Microsoft Entra ID / Azure AD.
#
# Copy this file to a deployment-specific secret env file outside git and
# replace all placeholders before use.
#
# This example uses the generic OIDC provider with the tenant-specific issuer.
# `preferred_username` is used as the identity/email claim because many Entra
# tenants do not emit the `email` claim by default for managed accounts.

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/replace-with-tenant-id/v2.0
OAUTH2_PROXY_CLIENT_ID=replace-with-your-entra-app-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-your-entra-app-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-secret

OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SCOPE=openid profile email offline_access
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=preferred_username
OAUTH2_PROXY_UPSTREAMS=file:///dev/null
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_EXPIRE=8h

# Optional access restrictions:
# OAUTH2_PROXY_ALLOWED_GROUPS=group-object-id-1,group-object-id-2
#
# If your Entra tokens include a true `email` claim and you want to use it
# instead of UPN/preferred username, change:
# OAUTH2_PROXY_OIDC_EMAIL_CLAIM=email
