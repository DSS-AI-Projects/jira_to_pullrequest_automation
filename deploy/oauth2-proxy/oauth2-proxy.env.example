# oauth2-proxy environment example for shared/team deployment.
#
# Copy to a deployment-specific secret store or env file outside git.
# Replace all placeholder values before use.

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.example.com/realms/your-realm
OAUTH2_PROXY_CLIENT_ID=replace-with-your-oidc-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-your-oidc-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-secret

OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
# The compose stack overrides the redirect URL from APP_HOSTNAME.
# Keep this line only if you run oauth2-proxy outside that compose topology.
# OAUTH2_PROXY_REDIRECT_URL=https://app.example.com/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SCOPE=openid profile email
OAUTH2_PROXY_UPSTREAMS=file:///dev/null
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_EXPIRE=8h
