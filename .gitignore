# Secrets — never commit; .env.example (names only) is the committed template
.env
*.env.local

# Extra CA certificates for a self-hosted provider instance behind an
# internal CA (see backend/certs/README.md) — deployment-specific, never
# committed; the directory itself (with its README) stays tracked so the
# Dockerfile's COPY always has something to copy.
backend/certs/*.crt
backend/certs/*.pem
certs/
backend/certs/
# App runtime data (SQLite DB, repo clones)
var/
*.db

# Temporary local debug artifacts
.dbg/
debug-*.md

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
